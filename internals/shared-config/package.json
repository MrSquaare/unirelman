{
  "name": "@unirelman/shared-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./oxlint": "./src/oxlint.ts",
    "./tsconfig": "./tsconfig.json",
    "./vitest": "./src/vitest.ts"
  },
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm run fmt:check && pnpm run lint",
    "check:fix": "pnpm run fmt && pnpm run lint:fix"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.2",
    "eslint-plugin-perfectionist": "^5.13.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "oxlint": "^1.90.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
