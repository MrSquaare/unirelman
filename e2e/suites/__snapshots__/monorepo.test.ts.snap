exports[`monorepo > fixed scopes > should fail when fixed scopes have different current versions 1`] = `
"unirelman · Version
error: Plugin "semver" failed in the computeNextVersion phase: Fixed scopes must share the same current version: @example/core (1.0.0), @example/ui (1.1.0)
❌ An error occurred during versioning.
"
`;

exports[`monorepo > independent scopes > should fail when a changeset names an unknown scope 1`] = `
"unirelman · Create changeset
error: Unknown scopes "@example/missing". Known scopes: @example/core, @example/ui
❌ The command failed.
"
`;

