// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`cli > should fail on an unknown option of a command 1`] = `
{
  "stderr": "error: Unknown option "--levle". Known options: --scopes, --level, --message
",
  "stdout": "",
}
`;

exports[`cli > should fail when an option that would be prompted is missing outside a terminal 1`] = `
{
  "stderr": "unirelman · Create changeset
error: --message is required: prompts are unavailable in plain and JSON modes
❌ The command failed.
",
  "stdout": "",
}
`;

exports[`cli > should print the usage and fail without a command 1`] = `
{
  "stderr": "Universal Release Manager CLI

Usage: unirelman <command> [options]

Commands:
  version     Compute and apply the next versions
  publish     Publish the current versions
  changesets  Manage changesets
  semver      Manage semver versions

Global options:
  -C, --config <path>  Path to the configuration file
  -v, --verbose        Show every log message, and the stack traces of errors
  --interactive        Show progress and prompt for missing options (default in an interactive terminal)
  --plain              Print plain lines and never prompt (default outside an interactive terminal)
  --json               Print the result of the command as JSON on standard output, and never prompt
  -h, --help           Print the usage of the command
  --version            Print the version of the CLI
",
  "stdout": "",
}
`;

exports[`cli > should print the usage of a command 1`] = `
{
  "stderr": "",
  "stdout": "Create a changeset

Usage: unirelman changesets create [options]

Options:
  --scopes <@example/core, @example/ui>  Scope(s) affected by this changeset
  --level <level>                        Level of the changeset
  --message <message>                    Message describing the change

Global options:
  -C, --config <path>  Path to the configuration file
  -v, --verbose        Show every log message, and the stack traces of errors
  --interactive        Show progress and prompt for missing options (default in an interactive terminal)
  --plain              Print plain lines and never prompt (default outside an interactive terminal)
  --json               Print the result of the command as JSON on standard output, and never prompt
  -h, --help           Print the usage of the command
  --version            Print the version of the CLI
",
}
`;
